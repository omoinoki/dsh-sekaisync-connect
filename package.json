{
  "name": "dsh-sekaisync-connect",
  "version": "0.3.9-alpha.1",
  "description": "SekaiSync 知识库的 DeepSeek Harness 直连模块：零构建、token 最小化。插件拉起 sekaisync HTTP 服务并暴露 10 个紧凑工具（含动态热词探针、活动简称/箱活名统一解析与跨语言用语穿透），并在插件面板中提供部署路径选择。",
  "type": "module",
  "scripts": {
    "test": "node --test scripts/runtime.test.mjs scripts/config.test.mjs scripts/deploy.test.mjs scripts/panel.test.mjs scripts/regional-output.test.mjs scripts/tool-contract.test.mjs scripts/status-errors.test.mjs scripts/alias-errors.test.mjs",
    "verify": "node scripts/verify-version-gate.mjs && node scripts/verify-host-half.mjs && node scripts/verify-client-half.mjs && node scripts/verify-docs.mjs && node scripts/verify-entry-compat.mjs && node scripts/audit-timeouts.mjs",
    "verify:e2e": "node scripts/verify-panel-e2e.mjs",
    "benchmark": "node scripts/benchmark-runtime.mjs",
    "test:integration": "node scripts/verify-integration.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "zukunftsholz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omoinoki/dsh-sekaisync-connect.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sekaisync",
    "project-sekai",
    "knowledge-base",
    "toolkit"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "config.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    ".github/readme",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  }
}
